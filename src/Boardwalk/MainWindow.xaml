<Window x:Class="Boardwalk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boardwalk"
        Icon="Assets/boardwalk.ico"
        Style="{StaticResource AppWindow}"
        Width="1280" Height="800" MinWidth="760" MinHeight="480">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar: the list of boards ================= -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,18,14">
                    <Image Source="Assets/boardwalk-256.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Boardwalk" FontSize="19" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="NewBoardButton" DockPanel.Dock="Top" Style="{StaticResource AccentButton}" Margin="14,0,14,12"
                        HorizontalAlignment="Stretch" ToolTip="New board (Ctrl+Shift+N)" Click="NewBoard_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource AccentText}"/>
                        <TextBlock Text="New board"/>
                    </StackPanel>
                </Button>

                <!-- Sync is planned: say so plainly, and that boards are on this PC for now -->
                <Border x:Name="SyncCard" DockPanel.Dock="Bottom" Margin="14,6,14,10" Padding="12,10" CornerRadius="8"
                        Background="{DynamicResource AccentSoft}" ToolTip="Boardwalk keeps your boards on this PC. Syncing them between your devices is coming in a future version.">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE753;" FontSize="18" VerticalAlignment="Top"
                                   Margin="0,1,10,0" Foreground="{DynamicResource Accent}"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sync" FontWeight="SemiBold"/>
                                <Border Background="{DynamicResource Accent}" CornerRadius="4" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Coming soon" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Your boards are saved on this PC for now." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DockPanel DockPanel.Dock="Bottom" Margin="10,0,10,0">
                    <!-- Quick Light/Dark switch (Settings also has Follow System) -->
                    <Button x:Name="ThemeToggle" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="ThemeToggle_Click"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource FlatBase}"
                            HorizontalContentAlignment="Left" Padding="10,8" Click="Settings_Click" ToolTip="Settings (Ctrl+,)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="Boards" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="20,4,0,4"/>

                <ListBox x:Name="BoardList" Background="Transparent" BorderThickness="0" Padding="8,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="BoardList_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- ================= The board ================= -->
        <Grid Grid.Column="1" Background="{DynamicResource BoardBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="BoardHeader" Grid.Row="0" Margin="24,16,16,12" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="220" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox" Padding="30,5,8,5" TextChanged="SearchBox_TextChanged" ToolTip="Search cards (Ctrl+F)"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" HorizontalAlignment="Left" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Search cards" Foreground="{DynamicResource TextSecondary}" Margin="31,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <ComboBox x:Name="LabelFilter" Width="150" Margin="0,0,8,0" ToolTip="Show only cards with this label"
                              SelectionChanged="LabelFilter_SelectionChanged"/>
                    <Button x:Name="AddColumnButton" Margin="0,0,4,0" Click="AddColumn_Click" ToolTip="Add a column">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Column"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BoardMenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Board options" Click="BoardMenu_Click"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BoardDot" Width="12" Height="12" CornerRadius="3" Margin="0,2,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BoardTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="Double-click to rename (F2)" MouseLeftButtonDown="BoardTitle_MouseDown"/>
                    </StackPanel>
                    <TextBlock x:Name="BoardSubtitle" Style="{StaticResource Hint}" Margin="22,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer x:Name="BoardScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Padding="24,0,24,14" PreviewMouseWheel="BoardScroll_PreviewMouseWheel" Focusable="False">
                <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- Shown when there are no boards yet -->
            <StackPanel x:Name="EmptyState" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="Collapsed">
                <Image Source="Assets/boardwalk-256.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Make your first board" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="14" TextAlignment="Center"
                           Text="A board holds the cards for one project, with a column for each stage. Make as many boards as you like, one for each project."/>
                <Button Style="{StaticResource AccentButton}" Content="New board" HorizontalAlignment="Center" Margin="0,18,0,0" Click="NewBoard_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
